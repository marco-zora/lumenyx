@page "/instruction-gallery"

@using BlazorPWA.Components


<h3>Test immagine</h3>

<img src="media/video_frame_playback.png" alt="Anteprima video" />

<h3>Nuova VideoInstruction</h3>

<VideoInstruction />

<h3>Lista istruzioni (anteprima)</h3>

@* Mostra InstructionList con dati di esempio per verificare l'aspetto finale *@
<InstructionList Instructions="Instructions" />

<style>

    .gallery {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        padding: 1rem;
        align-items: flex-start;
    }

</style>

@code {
    private List<InstructionItem> Instructions { get; set; } = new()
    {
        new InstructionItem { Type = "video", MediaId = null, DurationSeconds = 12 },
        new InstructionItem { Type = "image", MediaId = null, DurationSeconds = 5 },
        new InstructionItem { Type = "video", MediaId = null, DurationSeconds = 8 }
    };
}