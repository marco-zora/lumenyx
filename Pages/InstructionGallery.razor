@page "/instruction-gallery"

@*per chiamare i metodi del componente, bisogna avere una reference al componente*@
<div class="preview">

    <button @onclick="Run">RUN</button>
    <VM @ref="vm" Instructions="@sequenza" />

</div>




@code {

    private List<Instruction> sequenza { get; set; } =
   [
        new Instruction{ Type="video", MediaUrl="media/VIDEO-002.mp4"},
        new Instruction{ Type="video", MediaUrl="media/VIDEO-003.mp4"},
        new Instruction{ Type="video", MediaUrl="media/VIDEO-004.mp4"},
        new Instruction{ Type="video", MediaUrl="media/VIDEO-002.mp4"},
        new Instruction{ Type="video", MediaUrl="media/VIDEO-003.mp4"},
        new Instruction{ Type="video", MediaUrl="media/VIDEO-004.mp4"}
   ];

    private VM? vm;

    private async Task Run()
    {
        await vm!.Run(2);    // con vm! ci assicuriamo che il componente non puo essere NULL
    }


}


<style>

    .preview {
        width: 80%;
    }

</style>