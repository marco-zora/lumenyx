@code {

    private string WebhookUrl = "https://nocodb.irib.cnr.it/n8n/webhook/df646fe7-47a9-462c-8ae6-aaa8f3acbc6e";

    private string Messaggio = "";

    private string ServiceWorkerVersion = "?";

    private async Task InviaWebhook()
    {
        try
        {
            //var response = await Http.PostAsJsonAsync(WebhookUrl, payload);            
            //var response = await SendCommand("comando", "parametro");
            //var result = await response.Content.ReadFromJsonAsync<Dictionary<string, object>>();

            var response = await SendCommand("comando", "parametro");

            Messaggio = response["parameter"]?.ToString() ?? "";
        }
        catch (Exception ex)
        {
            Messaggio = ex.ToString();
        }
    }

    private async Task <Dictionary<string, object>> SendCommand(string cmd,string param)
    {
        var payload = new
        {
            cmd = cmd,
            param = param,
            ID = "TV001"
        };

        var response = await Http.PostAsJsonAsync(WebhookUrl, payload);
        return await response.Content.ReadFromJsonAsync<Dictionary<string, object>>() ?? new Dictionary<string, object>();
    }
    
    public class SWInfo
    {
    public string? Active { get; set; }
    public string? Waiting { get; set; }
    public string? Script { get; set; }
    }
