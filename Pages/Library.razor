@code {
    [Inject]
    private IJSRuntime JS { get; set; } = default!;

    private List<BlazorPWA.Components.CollectionModel>? _collections;
    private List<BlazorPWA.Components.MediaItem> _allMedia = new();

    private readonly HashSet<SelectedMedia> _selectedItems = new();

    private readonly Dictionary<BlazorPWA.Components.MediaItem, string>
        _rowItemCollections = new(ReferenceEqualityComparer.Instance);

    private bool _showMovePanel;
    private string _targetCollectionId = "";

    private int SelectedCount => _selectedItems.Count;

    protected override async Task OnInitializedAsync()
    {
        _allMedia = await MediaService.GetAllAsync();
        _collections = await MediaService.GetCollectionsAsync();
    }

    private async Task CreateCollection()
    {
        var title = await JS.InvokeAsync<string?>(
            "prompt",
            "Nome della nuova collezione");

        if (string.IsNullOrWhiteSpace(title))
            return;

        _collections ??= new();

        _collections.Add(new BlazorPWA.Components.CollectionModel
        {
            Title = title.Trim(),
            Items = new()
        });

        StateHasChanged();
    }

    private static string GetCollectionId(
        BlazorPWA.Components.CollectionModel collection)
    {
        // Nel modello attuale non è stata mostrata una proprietà Id.
        // Il titolo viene quindi usato come identificatore della collezione.
        return collection.Title;
    }

    private List<BlazorPWA.Components.MediaItem> BuildRowItems(
        BlazorPWA.Components.CollectionModel collection,
        string collectionId)
    {
        var result = new List<BlazorPWA.Components.MediaItem>();

        foreach (var mediaId in collection.Items)
        {
            var source = _allMedia.FirstOrDefault(media => media.Id == mediaId);

            if (source is null)
                continue;

            var rowItem = new BlazorPWA.Components.MediaItem
            {
                Id = source.Id,
                Type = source.Type,
                Name = source.Name,
                Url = source.Url,
                ThumbnailUrl = source.ThumbnailUrl,
                DurationSeconds = source.DurationSeconds,
                Collection = source.Collection,
                IsSelected = _selectedItems.Contains(
                    new SelectedMedia(source.Id, collectionId))
            };

            _rowItemCollections[rowItem] = collectionId;
            result.Add(rowItem);
        }

        return result;
    }

    private Task OnSelectItem(BlazorPWA.Components.MediaItem rowItem)
    {
        if (!_rowItemCollections.TryGetValue(rowItem, out var collectionId))
            return Task.CompletedTask;

        var selection = new SelectedMedia(rowItem.Id, collectionId);

        if (rowItem.IsSelected)
            _selectedItems.Add(selection);
        else
            _selectedItems.Remove(selection);

        StateHasChanged();
        return Task.CompletedTask;
    }

    private void OpenMovePanel()
    {
        if (SelectedCount == 0)
            return;

        _targetCollectionId = "";
        _showMovePanel = true;
    }

    private void CancelMove()
    {
        _targetCollectionId = "";
        _showMovePanel = false;
    }

    private void ConfirmMove()
    {
        if (_collections is null || string.IsNullOrWhiteSpace(_targetCollectionId))
            return;

        var targetCollection = _collections.FirstOrDefault(
            collection => GetCollectionId(collection) == _targetCollectionId);

        if (targetCollection is null)
            return;

        foreach (var selected in _selectedItems.ToList())
        {
            var sourceCollection = _collections.FirstOrDefault(
                collection => GetCollectionId(collection) == selected.CollectionId);

            if (sourceCollection is null)
                continue;

            // Se origine e destinazione coincidono, non cambia nulla.
            if (ReferenceEquals(sourceCollection, targetCollection))
                continue;

            // Rimuove soltanto il riferimento dalla collezione di provenienza.
            sourceCollection.Items.Remove(selected.MediaId);

            // Le eventuali presenze dello stesso media in altre collezioni restano intatte.
            if (!targetCollection.Items.Contains(selected.MediaId))
                targetCollection.Items.Add(selected.MediaId);
        }

        DeselectAll();
        CancelMove();
    }

    private void DeselectAll()
    {
        _selectedItems.Clear();
        StateHasChanged();
    }

    private sealed record SelectedMedia(
        string MediaId,
        string CollectionId);
}
