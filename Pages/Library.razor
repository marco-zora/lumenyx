@page "/library"
@inject BlazorPWA.Services.IMediaService MediaService

<div class="library-page">
    <h1>Library</h1>

    @if (_collections == null)
    {
        <p>Loading...</p>
    }
    else
    {
        @foreach (var col in _collections)
        {
            var items = col.Items.Select(id => _allMedia.FirstOrDefault(m => m.Id == id)).Where(x => x != null).Select(x => x!).ToList();
            <MediaRow Title="@col.Title" Items="@items" Selected="OnSelectItem" />
        }
    }

</div>

@code {
    private List<BlazorPWA.Components.CollectionModel>? _collections;
    private List<BlazorPWA.Components.MediaItem> _allMedia = new();

    protected override async Task OnInitializedAsync()
    {
        _allMedia = await MediaService.GetAllAsync();
        _collections = await MediaService.GetCollectionsAsync();
    }

    private Task OnSelectItem(BlazorPWA.Components.MediaItem item)
    {
        // For now just log to console; could open preview/player
        Console.WriteLine($"Selected {item.Name} ({item.Id})");
        return Task.CompletedTask;
    }
}
