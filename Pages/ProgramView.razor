@page "/program/{DeviceId}"

@using BlazorPWA.Components.Instructions

<div class="program-layout">

    <div class="left-column">

        <section class="preview-panel">

            <div class="preview-frame">

                <div class="preview-content">

                    <i class="bi bi-display preview-icon"
                       aria-hidden="true">
                    </i>

                    <div class="preview-title">
                        Anteprima schermo
                    </div>

                    <div class="preview-subtitle">
                        Formato 16:9
                    </div>

                </div>

            </div>

        </section>

        <aside class="palette-panel">

            <div class="section-heading">

                <div class="section-title">
                    Istruzioni disponibili
                </div>

                <div class="section-description">
                    Premi + per aggiungere una istruzione
                </div>

            </div>

            <InstructionPalette OnAddInstruction="AddInstruction" />

        </aside>

    </div>

    <main class="sequence-panel">

        <div class="section-heading sequence-heading">

            <div class="sequence-title-row">

                <div class="section-title">
                    Sequenza
                </div>

                <div class="instruction-counter">
                    @Instructions.Count istruzioni
                </div>

            </div>

            <div class="section-description">
                Programma dello schermo
            </div>

        </div>

        <InstructionList Instructions="Instructions" />

    </main>

</div>

@code {

    [Parameter]
    public string DeviceId { get; set; } = string.Empty;

    private readonly List<InstructionItem> Instructions =
        new()
        {
            new() { Type = "video" },
            new() { Type = "image" },
            new() { Type = "video" }
        };

    private void AddInstruction(string instructionType)
    {
        if (string.IsNullOrWhiteSpace(instructionType))
        {
            return;
        }

        Instructions.Add(
            new InstructionItem
            {
                Type = instructionType
            });
    }

}