@page "/program/{DeviceId}"


<h3 class="page-title">
    Programma Device @DeviceId
</h3>

<div class="program-layout">

    <!-- PREVIEW 16:9 -->

    <section class="preview-panel">

        <div class="preview-frame">

            <div class="preview-content">

                <i class="bi bi-display preview-icon"
                   aria-hidden="true">
                </i>

                <div class="preview-title">
                    Anteprima schermo
                </div>

                <div class="preview-subtitle">
                    Formato 16:9
                </div>

            </div>

        </div>

    </section>

    <!-- PALETTE E SEQUENZA -->

    <section class="workspace">

        <!-- PALETTE -->

        <aside class="palette-panel">

            <div class="section-heading">

                <div class="section-title">
                    Istruzioni disponibili
                </div>

                <div class="section-description">
                    Trascina un’istruzione nella sequenza
                </div>

            </div>

            <InstructionPalette OnInstructionDragStart="HandleInstructionDragStart" />

        </aside>

        <!-- LISTA ISTRUZIONI -->

        <main class="sequence-panel">

            <div class="section-heading sequence-heading">

                <div>

                    <div class="section-title">
                        Sequenza
                    </div>

                    <div class="section-description">
                        Programma dello schermo
                    </div>

                </div>

                <div class="instruction-counter">
                    @Instructions.Count istruzioni
                </div>

            </div>

            <div class="drop-zone"
                 @ondragover:preventDefault="true"
                 @ondrop="HandleDrop">

                <InstructionList>

                    @foreach (var instruction in Instructions)
                    {
                        <div @key="instruction.Id">

                            @switch (instruction.Type)
                            {
                                case "video":

                                    <VideoInstruction />

                                    break;

                                case "image":

                                    <ImageInstruction />

                                    break;
                            }

                        </div>
                    }

                </InstructionList>

            </div>

        </main>

    </section>

</div>

@code {
    [Parameter]
    public string DeviceId { get; set; } = "";

    private void HandleDrop(DragEventArgs e)
    {
        if (string.IsNullOrWhiteSpace(
            DraggedInstructionType))
        {
            return;
        }

        Instructions.Add(
            new InstructionItem
            {
                Type = DraggedInstructionType
            });

        DraggedInstructionType = null;
    }

    private string? DraggedInstructionType;

    private sealed class InstructionItem
    {
        public Guid Id { get; set; } = Guid.NewGuid();

        public string Type { get; set; } = "";
    }

    private List<InstructionItem> Instructions = new()
{
    new() { Type = "video" },
    new() { Type = "image" },
    new() { Type = "video" }
};

    private void HandleInstructionDragStart(
        string instructionType)
    {
        DraggedInstructionType = instructionType;
    }

   
}

