                                    <path d="M20 6L9 17L4 12"
                                          fill="none"
                                          stroke="currentColor"
                                          stroke-width="3"
                                          stroke-linecap="round"
                                          stroke-linejoin="round" />
                                </svg>
                            </div>
                        }
                    </div>
                }
                *@

            </div>
        </div>

        <button class="row-arrow right" @onclick="() => Scroll(1)" aria-label="Scroll right">
            <svg width="18" height="32" viewBox="0 0 18 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M3 2L15 16L3 30" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
        </button>
    </div>

</div>

@code {

    [Parameter]
    public string Title { get; set; } = "";

    [Parameter]
    public List<MediaItem> Items { get; set; } = new();

    [Parameter]
    public EventCallback<MediaItem> Selected { get; set; }

    [Inject]
    private IJSRuntime JSRuntime { get; set; } = default!;

    private IJSObjectReference? _module;

    private ElementReference _trackRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        _module = await JSRuntime.InvokeAsync<IJSObjectReference>(
            "import",
            "./js/carouselInterop.js");
    }

    private async Task Scroll(int dir)
    {
        if (_module is null)
            return;

        var offset =
            (int)(await JSRuntime.InvokeAsync<double>(
                "eval",
                "window.innerWidth") * 0.7) * dir;

        await _module.InvokeVoidAsync(
            "scrollByOffset",
            _trackRef,
            offset);
    }

    private async Task OnSelect(MediaItem item)
    {
        item.IsSelected = !item.IsSelected;

        if (Selected.HasDelegate)
            await Selected.InvokeAsync(item);
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch
            {
            }
        }
    }

    private static string FormatDuration(double durationSeconds)
    {
        var duration = TimeSpan.FromSeconds(durationSeconds);

        return duration.TotalHours >= 1
            ? duration.ToString(@"h\:mm\:ss")
            : duration.ToString(@"m\:ss");
    }
}
