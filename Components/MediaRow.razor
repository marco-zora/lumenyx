

<div class="media-row">
    <div class="row-header">
        <div class="collection-title">
            <h3>@Title</h3>
        </div>
    </div>

    <div class="row-body">
        <button class="row-arrow left" @onclick="() => Scroll(-1)" aria-label="Scroll left">
            <svg width="18" height="32" viewBox="0 0 18 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M15 2L3 16L15 30" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
        </button>

        <div class="carousel-viewport" @ref="_trackRef">
            <div class="carousel-track">
                @foreach (var item in Items)
                {
                    <div class="media-card" tabindex="0" @onclick="() => OnSelect(item)">
                        <img src="@item.ThumbnailUrl" alt="@item.Name" loading="lazy" />
                        <div class="media-label">@item.Name</div>
                    </div>
                }
            </div>
        </div>

        <button class="row-arrow right" @onclick="() => Scroll(1)" aria-label="Scroll right">
            <svg width="18" height="32" viewBox="0 0 18 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M3 2L15 16L3 30" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
        </button>
    </div>

</div>

