
<div class="instruction-card">

    <div class="instruction-thumbnail">
        @if (ThumbnailContent != null)
        {
            @ThumbnailContent
        }
        else if (ChildContent != null)
        {
            @ChildContent
        }
    </div>

    <div class="instruction-main">
        @if (MainContent != null)
        {
            @MainContent
        }
        else if (ChildContent != null)
        {
            @ChildContent
        }
    </div>

    <div class="instruction-menu">
        @MenuContent
    </div>

</div>

@code {

    [Parameter]
    public RenderFragment? ThumbnailContent { get; set; }

    [Parameter]
    public RenderFragment? MainContent { get; set; }

    [Parameter]
    public RenderFragment? MenuContent { get; set; }

    // Compatibilità: molti componenti passano contenuto figlio usando ChildContent
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    // Parametri opzionali usati in altri punti del progetto
    [Parameter]
    public string Icon { get; set; } = "bi-circle";

    [Parameter]
    public string Type { get; set; } = string.Empty;

    [Parameter]
    public bool Selected { get; set; }

    [Parameter]
    public EventCallback OnClick { get; set; }
}



