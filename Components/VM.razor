@page "/VM"
@inject IJSRuntime JS

<h3>VM</h3>

<div class="vm-output">

    @* Il chiamante definisce il Monitor *@
    

    @* La VM possiede i renderer *@
    <div class="vm-output">

        <video id="@Video1Id"
               class="vm-renderer"
               playsinline>
        </video>

        <video id="@Video2Id"
               class="vm-renderer"
               playsinline>
        </video>

        <video id="@Video3Id"
               class="vm-renderer"
               playsinline>
        </video>

    </div>

</div>

@*visualizza le istruzioni che vengono eseguire in real time*@
<div class="vm-instructions">
    @line
</div>


@code
{
    private string Video1Id => "Video1";
    private string Video2Id => "Video2";
    private string Video3Id => "Video3";

    // =========================
    // INPUT
    // =========================
    [Parameter]
    public List<Instruction> Instructions { get; set; } =
    [
        new Instruction{ Type="video", MediaUrl="media/VIDEO-001.mp4"},
        new Instruction{ Type="video", MediaUrl="media/VIDEO-002.mp4"}
    ];


    // =========================
    // OUTPUT
    // =========================
    //[Parameter]
    //public RenderFragment? Monitor { get; set; }



    string line = "";
    /// <summary>
    /// Metodi esposti dal Componente RAZOR
    /// </summary>
    /// <returns></returns>
    public async Task Run(int OverlaySeconds=2)
    {
        // qui chiameremo JavaScript per video.play()
        int IP = 0;// Instruction Pointer

        string VideoId = "Video3";
        string NextVideoId = "";

        string Url = "";
        string NextUrl = "";

        line = "";

        for(IP=0;IP<Instructions.Count;IP++)
        {
            var instruction = Instructions[IP];

            //    await InvokeAsync(StateHasChanged);     // importante per aggiornare la UI dopo aver modificato il contenuto di "line"

            // Avvia il video e attende l'evento "ended"
            switch (instruction.Type)
            {
                case "video":
                    try
                    {
                        line += "[" + IP + "]\n"; await InvokeAsync(StateHasChanged);

                        VideoId = (VideoId == "Video1") ? Video2Id : ((VideoId == "Video2") ? "Video3" : "Video1");   //
                        NextVideoId = (VideoId == "Video1") ? Video2Id : (VideoId == "Video2") ? "Video3" : "Video1";  // PRELOAD sulla traccia successiva a quella in play
                        
                        /* LOAD sulla traccia successiva che non viene visualizzata */
                        if(IP+1 < Instructions.Count) // Esiste un video successivo? Precarica il prossimo video se non siamo all'ultima istruzione
                        {
                            NextUrl = Instructions[IP+1].MediaUrl;
                            line += " --- load(" + NextUrl + ") on " + NextVideoId + "\n"; await InvokeAsync(StateHasChanged);                            
                            await JS.InvokeVoidAsync("videoInterop.load", NextVideoId, NextUrl);                            
                        }

                        /* PLAY cosi seleziona la traccia video da visualizzare */
                        Url = instruction.MediaUrl;
                        line += "play (" + Url + ") on " + VideoId + "\n"; await InvokeAsync(StateHasChanged);
                        await JS.InvokeVoidAsync("videoInterop.play", VideoId, Url, OverlaySeconds);
                    }
                    catch (JSException ex)
                    {
                        line += " -> Errore video (" + ex.Message + ")";
                    }                       
                    break;

                default:
                    line += "Tipo di istruzione non supportato: " + instruction.Type; 
                    await InvokeAsync(StateHasChanged);
                    throw new NotImplementedException($"Tipo di istruzione non supportato: {instruction.Type}");                                        
            }
           
            //await Task.Delay(1000);     // simula il tempo di esecuzione dell'istruzione         
        }

    }
}





<script>
    window.videoInterop = {

        play: function(videoId, mediaUrl, OverlaySeconds) {

            const video = document.getElementById(videoId);

            video.src = mediaUrl;
            video.style.opacity = 1;
            video.style.transition = `opacity ${OverlaySeconds}s ease`;

            return new Promise((resolve, reject) => {

                /*
                video.onended = () => {
                    resolve();
                };
                */

                video.ontimeupdate = () => {

                    const tempoRimanente =
                        video.duration - video.currentTime;

                    if (tempoRimanente <= OverlaySeconds) {

                        video.style.opacity = 0;

                        resolve();
                    }
                };

                video.onerror = () => {
                    reject(new Error("Errore video: " + mediaUrl));
                };

                video.play().catch(reject);

            });
        },




        load: function (videoId, mediaUrl) {        

            const video = document.getElementById(videoId);

            if (!video) {
                console.error("Video non trovato:", videoId);
                return;
            }
            
            video.src = mediaUrl;
        }
    };
</script>

<style>

    .vm-output {
        position: relative;
        width: 100%;
        aspect-ratio: 16 / 9;
        overflow: hidden;
        background: black;
    }

    .vm-renderer {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: contain;
        opacity: 0;
        /*transition: opacity 2s linear;*/
    }

    .vm-instructions {
        white-space: pre-line;
        color: black;
    }

</style>