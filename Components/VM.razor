@page "/VM"
@inject IJSRuntime JS

<h3>VM</h3>

<div class="vm-output">

    @* Il chiamante definisce il Monitor *@
    

    @* La VM possiede i renderer *@
    <div class="vm-output">

        <video id="@Video1Id"
               class="vm-renderer"
               playsinline>
        </video>

        <video id="@Video2Id"
               class="vm-renderer"
               playsinline>
        </video>

    </div>

</div>

@*visualizza le istruzioni che vengono eseguire in real time*@
<div class="vm-instructions">
    @line
</div>


@code
{
    private readonly string VmId = Guid.NewGuid().ToString("N");    

    private string Video1Id => $"video1-{VmId}";
    private string Video2Id => $"video2-{VmId}";

    

    // =========================
    // INPUT
    // =========================
    [Parameter]
    public List<Instruction> Instructions { get; set; } =
    [
        new Instruction{ Type="video", MediaUrl="media/VIDEO-001.mp4"},
        new Instruction{ Type="video", MediaUrl="media/VIDEO-002.mp4"}
    ];


    // =========================
    // OUTPUT
    // =========================
    //[Parameter]
    //public RenderFragment? Monitor { get; set; }

    int IP = 0;// Instruction Pointer
    string line = "";
    int layer = 0;


    /// <summary>
    /// Metodi esposti dal Componente RAZOR
    /// </summary>
    /// <returns></returns>
    public async Task Run(int OverlaySeconds=2)
    {
        // qui chiameremo JavaScript per video.play()
        IP = 0;
        line = "";
        foreach(var instruction in Instructions)
        {
            line += IP + "-" + instruction.Type + "-" + instruction.MediaUrl + " - on layer:" + (IP%2);
            await InvokeAsync(StateHasChanged);     // importante per aggiornare la UI dopo aver modificato il contenuto di "line"

            // Avvia il video e attende l'evento "ended"
            switch (instruction.Type)
            {
                case "video":
                    try
                    {                
                        if(IP%2==0) await JS.InvokeVoidAsync("videoInterop.play", Video2Id, instruction.MediaUrl, OverlaySeconds);
                        else await JS.InvokeVoidAsync("videoInterop.play", Video1Id, instruction.MediaUrl, OverlaySeconds);
                    }
                    catch (JSException ex)
                    {
                        line += " -> Errore video (" + ex.Message + ")";
                    }                       
                    break;
                default:
                    line += "Tipo di istruzione non supportato: " + instruction.Type; 
                    await InvokeAsync(StateHasChanged);
                    throw new NotImplementedException($"Tipo di istruzione non supportato: {instruction.Type}");                                        
            }

            line += "\n";
            await InvokeAsync(StateHasChanged);
            //await Task.Delay(1000);     // simula il tempo di esecuzione dell'istruzione
            IP++;            
        }

    }
}


<style>

    .vm-output {
        position: relative;
        width: 100%;
        aspect-ratio: 16 / 9;
        overflow: hidden;
        background: black;
    }

    .vm-renderer {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: contain;
        opacity: 0;
        /*transition: opacity 2s linear;*/
    }

    .vm-instructions {
        white-space: pre-line;
        color: black;
    }

</style>


<script>
    window.videoInterop = {

        play: function(videoId,mediaUrl,OverlaySeconds) {

            const video = document.getElementById(videoId);

            video.src = mediaUrl;
            video.style.opacity = 1;    // impiegherà 2 secondi a comparire
            video.style.transition =    `opacity ${OverlaySeconds}s ease`;

            return new Promise((resolve, reject) => {

                video.onended = () => {
                    resolve();
                };


                video.ontimeupdate = () => {

                    const tempoRimanente = video.duration - video.currentTime;

                    if (tempoRimanente <= OverlaySeconds) { 
                        video.style.opacity = 0; // impiegherà 2 secondi a scomparire                    
                        resolve(); // risolviamo la Promise quando mancano 2 secondi alla fine del video
                    }
                };


                video.onerror = () => {
                    reject(new Error("Errore video: " + mediaUrl));
                };

                video.play().catch(reject);
            });
        }

    };
</script>

