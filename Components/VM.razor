@page "/VM"
@inject IJSRuntime JS

<h3>VM</h3>

<div class="vm-output">

    @* Il chiamante definisce il Monitor *@
    

    @* La VM possiede i renderer *@
    <div class="vm-output">

        <video id="@Video1Id"
               class="vm-renderer"
               playsinline>
        </video>

        <video id="@Video2Id"
               class="vm-renderer"
               playsinline>
        </video>

        <video id="@Video3Id"
               class="vm-renderer"
               playsinline>
        </video>

    </div>

</div>

@*visualizza le istruzioni che vengono eseguire in real time*@
<div class="vm-instructions">
    @line
</div>


@code
{
    private string Video1Id => "Video1";
    private string Video2Id => "Video2";
    private string Video3Id => "Video3";

    // =========================
    // INPUT
    // =========================
    [Parameter]
    public List<Instruction> Instructions { get; set; } =
    [
        new Instruction{ Type="video", MediaUrl="media/VIDEO-001.mp4"},
        new Instruction{ Type="video", MediaUrl="media/VIDEO-002.mp4"}
    ];


    // =========================
    // OUTPUT
    // =========================
    //[Parameter]
    //public RenderFragment? Monitor { get; set; }



    string line = "";
    /// <summary>
    /// Metodi esposti dal Componente RAZOR
    /// </summary>
    /// <returns></returns>
    public async Task Run(int OverlaySeconds=2)
    {
        // qui chiameremo JavaScript per video.play()
        int IP = 0;// Instruction Pointer

        string VideoId = "Video1";
        string NextVideoId = "Video2";

        string Url = "";
        string NextUrl = "";

        line = "";

        for(IP=0;IP<Instructions.Count;IP++)
        {
            var instruction = Instructions[IP];
            Url = Instructions[IP].MediaUrl;

            //    await InvokeAsync(StateHasChanged);     // importante per aggiornare la UI dopo aver modificato il contenuto di "line"

            // Avvia il video e attende l'evento "ended"
            switch (instruction.Type)
            {
                case "video":
                    try
                    {
                        line += "[" + IP + "]\n"; await InvokeAsync(StateHasChanged);

                        /* PRIMO LOAD */
                        if (IP == 0) 
                        {
                            
                            line += " --- first load(" + Url + ") on " + VideoId + "\n"; await InvokeAsync(StateHasChanged);
                            await JS.InvokeVoidAsync("videoInterop.load", VideoId, Url);
                        }

                        line += "play (" + Url + ") on " + VideoId + "\n"; await InvokeAsync(StateHasChanged);
                        // PLAY Video1.
                        await JS.InvokeVoidAsync(
                            "videoInterop.play",
                            VideoId,
                            OverlaySeconds);

                        // PRELOAD SECONDO VIDEO SE PRESENTE
                        if (IP + 1 < Instructions.Count && Instructions[IP + 1].Type == "video") // Esiste un video successivo? Precarica il prossimo video se non siamo all'ultima istruzione
                        {              
                            NextUrl = Instructions[IP + 1].MediaUrl;
                            NextVideoId = (VideoId == "Video1") ? "Video2" : (VideoId == "Video2") ? "Video3" : "Video1";  // PRELOAD sulla traccia successiva a quella in play                            

                            line += " --- preload(" + NextUrl + ") on " + NextVideoId + "\n"; await InvokeAsync(StateHasChanged);
                            // LOAD Video2.
                            await JS.InvokeVoidAsync(
                                "videoInterop.load",
                                NextVideoId,
                                NextUrl);
                        }

                        line += "waitOverlay (" + Url + ") on " + VideoId + "\n"; await InvokeAsync(StateHasChanged);
                        // Aspetta il momento di overlay.
                        // NON blocca Video1.
                        await JS.InvokeVoidAsync(
                            "videoInterop.waitOverlay",
                            VideoId,
                            OverlaySeconds);

                        line += "Overlay started \n"; await InvokeAsync(StateHasChanged);
                        
                        VideoId = (VideoId == "Video1") ? "Video2" : ((VideoId == "Video2") ? "Video3" : "Video1");   

                        //await Task.Delay(1000);     // simula il tempo di esecuzione dell'istruzione
                    }
                    catch (JSException ex)
                    {
                        line += " -> Errore video (" + ex.Message + ")";
                    }                       
                    break;

                default:
                    line += "Tipo di istruzione non supportato: " + instruction.Type; 
                    await InvokeAsync(StateHasChanged);
                    throw new NotImplementedException($"Tipo di istruzione non supportato: {instruction.Type}");                                        
            }
           
            //await Task.Delay(1000);     // simula il tempo di esecuzione dell'istruzione         
        }

    }
}





<script>
    window.videoInterop = {

            play: function (videoId, overlaySeconds) {

                const video = document.getElementById(videoId);

                if (!video) throw new Error("Video non trovato: " + videoId);

                video.style.transition = `opacity ${overlaySeconds}s ease`;
            
                // Avvia la dissolvenza in ingresso
                video.style.opacity = 1;

                video.play()
                    .then(() => {
                        console.log("PLAY OK:", videoId);
                    })
                    .catch(error => {
                        console.error(
                            "PLAY ERROR:",
                            videoId,
                            error.name,
                            error.message
                        );
                    });            
            },

            waitOverlay: function (videoId, overlaySeconds) {

                const video = document.getElementById(videoId);

                if (!video) throw new Error("Video non trovato: " + videoId);

                video.style.transition = `opacity ${overlaySeconds}s ease`;

                return new Promise(resolve => {

                    video.addEventListener("timeupdate", function check() {

                        const remaining = video.duration - video.currentTime;

                        if (remaining <= overlaySeconds) {

                            video.removeEventListener("timeupdate", check);

                            video.style.opacity = 0;

                            resolve();
                        }

                    });

                });
            },


            waitEnded: function(videoId) {

                const video = document.getElementById(videoId);

                if (!video)
                    return Promise.reject(
                        new Error("Video non trovato: " + videoId)
                    );

                if (video.ended)
                    return Promise.resolve();

                return new Promise((resolve) => {

                    video.addEventListener(
                        "ended",
                        () => resolve(),
                        { once: true }
                    );
                });
            },


            load: function(videoId, mediaUrl) {

                const video = document.getElementById(videoId);

                if (!video)
                    throw new Error("Video non trovato: " + videoId);

                video.src = mediaUrl;
                video.load();
            },


            stop: function(videoId) {

                const video = document.getElementById(videoId);

                if (!video)
                    return;

                video.pause();
                video.removeAttribute("src");
                video.load();
                video.style.opacity = 0;
            }
        };

</script>

<style>

    .vm-output {
        position: relative;
        width: 100%;
        aspect-ratio: 16 / 9;
        overflow: hidden;
        background: black;
    }

    .vm-renderer {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: contain;
        opacity: 0;
        will-change: opacity;
        transform: translateZ(0);
    }


    .vm-instructions {
        white-space: pre-line;
        color: black;
    }

</style>