@inject BlazorPWA.Services.IMediaService MediaService

<InstructionCard>

    <ThumbnailContent>
        @if (!string.IsNullOrWhiteSpace(SelectedThumbnailUrl))
        {
            <img src="@SelectedThumbnailUrl"
                 class="video-thumbnail"
                 alt="Thumbnail del video selezionato" />
        }

    

        else
        {
            <div class="video-thumbnail-placeholder">
                <i class="bi bi-play-fill"></i>
            </div>
        }
    </ThumbnailContent>

    <MainContent>
        <div class="video-title">
            @(string.IsNullOrWhiteSpace(SelectedVideoName)
                ? "Nessun video selezionato"
                : SelectedVideoName)
        </div>

        <div class="video-subtitle">
            Video · @FormatDuration(SelectedDurationSeconds)
        </div>
    </MainContent>

    <MenuContent>

        @if (ShowMenu)
        {
            <div class="menu-overlay"
                 @onclick="CloseMenu">
            </div>
        }

        <div class="video-menu-container">

            <button type="button"
                    class="menu-btn"
                    title="Modifica istruzione"
                    aria-label="Modifica istruzione video"
                    @onclick="ToggleMenu"
                    @onclick:stopPropagation="true">
                <i class="bi bi-three-dots-vertical"></i>
            </button>

            @if (ShowMenu)
            {
                <div class="video-menu"
                     @onclick:stopPropagation="true">

                    @if (!ShowVideoList)
                    {
                        <div class="video-menu-header">
                            VIDEO
                        </div>

                        <button type="button"
                                class="video-menu-item"
                                @onclick="OpenVideoList">
                            <i class="bi bi-play-circle"></i>
                            <span>Seleziona video</span>
                        </button>

                        <div class="video-menu-divider"></div>

                        <button type="button"
                                class="video-menu-item"
                                @onclick="ChangeType">
                            <i class="bi bi-arrow-repeat"></i>
                            <span>Cambia tipo</span>
                        </button>
                    }
                    else
                    {
                        @* Render the video picker as a fixed overlay so it remains visible on small screens *@
                        <!-- overlay without dimming -->
                        <div class="video-picker-overlay" @onclick="CloseVideoList" style="position:fixed;inset:0;display:flex;align-items:flex-start;justify-content:center;padding-top:4.5rem;z-index:1200;pointer-events:auto;">
                            <div class="video-picker" @onclick:stopPropagation="true" style="width:320px;max-height:calc(100vh - 6rem);overflow:auto;background:white;border-radius:8px;border:1px solid #e6eef6;box-shadow:0 8px 28px rgba(16,24,40,0.12);">
                                <div class="video-list-header" style="display:flex;align-items:center;padding:0.5rem;border-bottom:1px solid #eef6fb;">
                                    <button type="button" class="video-back-btn" title="Torna al menu" aria-label="Torna al menu" @onclick="CloseVideoList">
                                        <i class="bi bi-arrow-left"></i>
                                    </button>
                                    <div style="flex:1;text-align:center;font-weight:600;">Seleziona video</div>
                                </div>

                                <div style="padding:0.5rem;">
                                    @if (IsLoadingVideos)
                                    {
                                        <div class="video-list-message">Caricamento video...</div>
                                    }
                                    else if (!string.IsNullOrWhiteSpace(LoadError))
                                    {
                                        <div class="video-list-message video-list-error">@LoadError</div>
                                    }
                                    else if (Videos.Count == 0)
                                    {
                                        <div class="video-list-message">Nessun video disponibile</div>
                                    }
                                    else
                                    {
                                        <div style="display:flex;flex-direction:column;gap:0.25rem;">
                                        @foreach (var video in Videos)
                                        {
                                            bool isSelected = video.Id == SelectedVideoId;

                                            <button type="button" class="video-list-item @(isSelected ? "selected" : null)" @onclick="() => SelectVideo(video)" style="display:flex;align-items:center;padding:0.4rem;border-radius:6px;border:1px solid transparent;">

                                                <div class="video-list-thumbnail" style="width:48px;height:36px;overflow:hidden;border-radius:6px;margin-right:0.5rem;flex:0 0 48px;">
                                                    @if (!string.IsNullOrWhiteSpace(video.ThumbnailUrl))
                                                    {
                                                        <img src="@video.ThumbnailUrl" style="width:100%;height:100%;object-fit:cover;" alt="@($"Thumbnail di {video.Name}")" loading="lazy" />
                                                    }
                                                    else
                                                    {
                                                        <div class="video-list-thumbnail-placeholder"><i class="bi bi-play-fill"></i></div>
                                                    }
                                                </div>

                                                <div style="flex:1;text-align:left;">
                                                    <div style="font-weight:600;">@video.Name</div>
                                                    <div style="font-size:0.85rem;color:#64748b;">Video · @TimeSpan.FromSeconds(video.DurationSeconds).ToString(@"mm\:ss")</div>
                                                </div>

                                                @if (isSelected)
                                                {
                                                    <i class="bi bi-check-lg video-selected-icon" style="margin-left:0.5rem;color:#0ea5a2;"></i>
                                                }

                                            </button>
                                        }
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </MenuContent>

</InstructionCard>

@code {
    [Parameter]
    public string SelectedVideoId { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> SelectedVideoIdChanged { get; set; }

    [Parameter]
    public EventCallback OnChangeType { get; set; }

    [Parameter]
    public bool OpenMenuOnRender { get; set; }

    [Parameter]
    public EventCallback<bool> OpenMenuOnRenderChanged { get; set; }

    // Id of the instruction this component represents (set by parent)
    [Parameter]
    public Guid InstructionId { get; set; }

    /// <summary>
    /// Invoked when the component was opened for insert and the user cancels without selecting a video.
    /// The parent should remove the corresponding InstructionItem.
    /// </summary>
    [Parameter]
    public EventCallback<Guid> RemoveRequested { get; set; }

    private List<MediaItem> Videos { get; set; } = new();
    private string SelectedVideoName { get; set; } = string.Empty;
    private string SelectedThumbnailUrl { get; set; } = string.Empty;
    
    private bool ShowMenu { get; set; }
    private bool ShowVideoList { get; set; }
    private bool IsLoadingVideos { get; set; }
    private bool VideosLoaded { get; set; }
    private string? LoadError { get; set; }
    private double SelectedDurationSeconds;
    private bool _openingForInsert;


    
    protected override void OnParametersSet()
    {
        if (VideosLoaded)
        {
            ApplyCurrentSelection();
        }
    }

    private void ToggleMenu()
    {
        ShowMenu = !ShowMenu;

        if (!ShowMenu)
        {
            ShowVideoList = false;
        }
    }

    private void CloseMenu()
    {
        ShowMenu = false;
        ShowVideoList = false;
    }

    private async Task OpenVideoList()
    {
        ShowVideoList = true;

        // Ensure latest media.json is fetched before showing the list
        try
        {
            await MediaService.RefreshAsync();
        }
        catch
        {
            // ignore refresh errors; LoadVideosAsync will surface a load error
        }

        // Always reload the local list from the service after refresh
        await LoadVideosAsync();
    }

    private void CloseVideoList()
    {
        // If this menu was opened as part of an insert flow and no video selected,
        // notify parent to remove the placeholder instruction.
        ShowVideoList = false;
        if (_openingForInsert && string.IsNullOrWhiteSpace(SelectedVideoId))
        {
            _openingForInsert = false;
            _ = RemoveRequested.InvokeAsync(InstructionId);
        }
    }

    // Expose a public API so parent can open the menu programmatically
    public async Task OpenMenuAsync(bool forInsert = false)
    {
        _openingForInsert = forInsert;

        ShowMenu = true;
        ShowVideoList = true;

        // Ensure latest media.json is fetched before showing the list
        try
        {
            await MediaService.RefreshAsync();
        }
        catch
        {
            // ignore refresh errors; LoadVideosAsync will surface a load error
        }

        await LoadVideosAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadVideosAsync()
    {
        IsLoadingVideos = true;
        LoadError = null;

        try
        {
            var media = await MediaService.GetAllAsync();

            Videos = media?
                .Where(item =>
                    string.Equals(
                        item.Type,
                        "video",
                        StringComparison.OrdinalIgnoreCase))
                .ToList()
                ?? new List<MediaItem>();

            VideosLoaded = true;
            ApplyCurrentSelection();
        }
        catch (Exception)
        {
            Videos.Clear();
            LoadError = "Impossibile caricare la lista dei video.";
        }
        finally
        {
            IsLoadingVideos = false;
        }
    }

    private void ApplyCurrentSelection()
    {
        if (string.IsNullOrWhiteSpace(SelectedVideoId))
        {
            SelectedVideoName = string.Empty;
            SelectedThumbnailUrl = string.Empty;
            return;
        }

        var selectedVideo = Videos.FirstOrDefault(
            video => video.Id == SelectedVideoId);

        if (selectedVideo is null)
        {
            SelectedVideoName = string.Empty;
            SelectedThumbnailUrl = string.Empty;
            return;
        }

        SelectedVideoName = selectedVideo.Name;
        SelectedThumbnailUrl = selectedVideo.ThumbnailUrl;
    }

    private async Task SelectVideo(MediaItem video)
    {
        SelectedVideoId = video.Id;
        SelectedVideoName = video.Name;
        SelectedThumbnailUrl = video.ThumbnailUrl;
        SelectedDurationSeconds = video.DurationSeconds;

        CloseMenu();

        await SelectedVideoIdChanged.InvokeAsync(SelectedVideoId);

        // If this menu was opened as part of an insert flow, clear the flag on the parent
        if (_openingForInsert)
        {
            _openingForInsert = false;
            try
            {
                await OpenMenuOnRenderChanged.InvokeAsync(false);
            }
            catch { }
        }
    }

    private async Task ChangeType()
    {
        CloseMenu();
        await OnChangeType.InvokeAsync();
    }

   
    private string FormatDuration(double seconds)
    {
        return TimeSpan
            .FromSeconds(seconds)
            .ToString(@"mm\:ss");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // If the parent set OpenMenuOnRender on the bound InstructionItem, open the menu now
        // We don't have direct access to the InstructionItem here; parent will set ShowMenu via binding when appropriate.
        await base.OnAfterRenderAsync(firstRender);

        if (OpenMenuOnRender)
        {
        await OpenMenuAsync(true);
 
        await OpenMenuOnRenderChanged.InvokeAsync(false);
        }

    }
}
