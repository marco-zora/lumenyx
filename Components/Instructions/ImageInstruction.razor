@inject BlazorPWA.Services.IMediaService MediaService


<InstructionCard Icon="bi-image"
                 Type="image">

    <select class="instruction-select"
            @bind="SelectedMediaId"
            @onclick:stopPropagation="true">

        @foreach (var image in Images)
        {
            <option value="@image.Id">
                @image.Name
            </option>
        }

    </select>

    <input type="number"
           class="instruction-input"
           min="1"
           max="999"
           title="Durata in secondi"
           @bind="DurationSeconds"
           @onclick:stopPropagation="true" />

</InstructionCard>

@code {

    [Parameter]
    public string SelectedMediaId { get; set; } = "";

    [Parameter]
    public int DurationSeconds { get; set; } = 10;

    private List<MediaItem> Images = new();

    protected override async Task OnInitializedAsync()
    {
        // refresh the media list each time the image menu may be opened
        try
        {
            await MediaService.RefreshAsync();
        }
        catch
        {
            // ignore refresh errors
        }

        var media = await MediaService.GetAllAsync();

        Images = media?
            .Where(x => string.Equals(x.Type, "image", System.StringComparison.OrdinalIgnoreCase))
            .ToList()
            ?? new();

        if (Images.Count > 0 && string.IsNullOrWhiteSpace(SelectedMediaId))
        {
            SelectedMediaId = Images[0].Id;
        }
    }

}